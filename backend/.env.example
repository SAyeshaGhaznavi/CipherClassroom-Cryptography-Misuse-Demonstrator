# Copy this file to .env and change the values if needed.
# Never commit the real .env file.

PORT=3001

# SQLite database file. The folder is created automatically.
DATABASE_PATH=./data/cipherclassroom.db

# Frontend address(es) allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:5173

# How many hours a login session lasts.
SESSION_HOURS=8

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Passwords used by "npm run seed" (at least 12 characters).
# Leave empty to get a random password printed once.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_PASSWORD=
